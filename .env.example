# =============================================================================
# InsightPulse — Root-level environment variables (shared / cross-service)
# =============================================================================
# Copy this file to .env and fill in any secrets before running.
#   cp .env.example .env
#
# Service-specific variables live in each service's own .env.example:
#   ingestion-service/.env.example
#   inference-service/.env.example
#   dashboard-frontend/.env.local.example
# =============================================================================

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Database name created on first start
POSTGRES_DB=insightpulse

# Superuser credentials (used by both postgres container and ingestion-service)
POSTGRES_USER=insightpulse
POSTGRES_PASSWORD=insightpulse_dev

# Full JDBC URL consumed by ingestion-service (overrides individual vars above
# when running outside Docker Compose)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/insightpulse

# ─── Kafka ────────────────────────────────────────────────────────────────────
# Bootstrap servers for services running on the host (outside Docker Compose).
# Inside Docker Compose, services use kafka:9092 automatically.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Main topic for market events (3 partitions, 1 replica in dev)
KAFKA_TOPIC_MARKET_EVENTS=market-events

# ─── gRPC (ingestion-service → inference-service) ────────────────────────────
# Host/port that ingestion-service uses to call inference-service via gRPC.
# Inside Docker Compose this is overridden to inference-service:50051.
GRPC_INFERENCE_HOST=localhost
GRPC_INFERENCE_PORT=50051

# ─── Ingestion Service ────────────────────────────────────────────────────────
# Port the Spring Boot REST/WebSocket server listens on
INGESTION_SERVER_PORT=8080

# Active Spring profile (local | docker | prod)
SPRING_PROFILES_ACTIVE=local

# ─── Inference Service ────────────────────────────────────────────────────────
# HTTP port for the FastAPI REST server
INFERENCE_HTTP_PORT=8000

# gRPC server port
INFERENCE_GRPC_PORT=50051

# Consumer group id for the Kafka consumer inside inference-service
KAFKA_CONSUMER_GROUP=inference-group

# HuggingFace model used for sentiment analysis (downloaded on first start)
MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── Dashboard Frontend ───────────────────────────────────────────────────────
# Inlined into the browser bundle at BUILD time (passed as docker build args).
# Changing them requires: docker compose build dashboard-frontend
# Base URL for REST calls from the browser to ingestion-service
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# WebSocket URL for live event streaming
NEXT_PUBLIC_WS_ENDPOINT=ws://localhost:8080/ws/stream

# ─── Docker Compose meta ──────────────────────────────────────────────────────
# Compose project name (prefix for network/volume names). Keep it at
# insight-pulse: changing it creates new, empty volumes, and the fixed
# container_name values would clash with the existing containers.
COMPOSE_PROJECT_NAME=insight-pulse
